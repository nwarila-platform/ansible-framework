!/applications/wazuh_agent/files/GPG-KEY-WAZUH

# openvpn_client executes two PowerShell scripts that are MATERIALIZED into files/ from the
# consuming repository's scripts/ directory. Only the build markers naming those sources are
# tracked here; the materialized .ps1 copies are build artifacts and are deliberately NOT
# allowlisted, so a stale or hand-edited copy can never be committed.
!/applications/openvpn_client/files/Set-DnsNamespaceForwarder.ps1.stub
!/applications/openvpn_client/files/Set-FileAcl.ps1.stub

