# Ignore everything by default
**

# Every allowlist negation is repository-rooted. make allowlist-check rejects rootless entries.

# Root config and docs
!/.ansible-lint
!/.editorconfig
!/.gitattributes
!/.gitignore
!/.pre-commit-config.yaml
!/.release-please-manifest.json
!/.yamllint.yml
!/ansible.cfg
!/CHANGELOG.md
!/CODE_OF_CONDUCT.md
!/CONTRIBUTING.md
!/LICENSE
!/Makefile
!/README.md
!/SECURITY.md
!/SUPPORT.md
!/release-please-config.json
!/requirements-dev.txt
!/requirements.yml
# The shared v3 loader's published sha256. Migration item 6: consumers format their
# copy only after this digest changes, and LOADER-01 verifies against it.
!/meta/
!/meta/loader-digest.txt


# Repository-level lookup plugins
!/lookup_plugins/
!/lookup_plugins/secret.py

# Framework-level tests and isolated controller fixtures
!/tests/
!/tests/secret_lookup/
!/tests/secret_lookup/test.yml
!/tests/secret_lookup/inventory
!/tests/secret_lookup/test_secret.py
!/tests/secret_lookup/fixtures/
!/tests/secret_lookup/fixtures/boto3.py
!/tests/secret_lookup/fixtures/botocore/
!/tests/secret_lookup/fixtures/botocore/__init__.py
!/tests/secret_lookup/fixtures/botocore/exceptions.py

# First-class PowerShell scripts and their Pester specs. A role that executes one tracks only
# files/<Name>.ps1.stub; scripts/materialize-role-scripts.sh copies the source below into the role
# before it runs. The source and its spec are reviewed once, here -- the materialized copy in a
# role's files/ directory is a build artifact and is never allowlisted anywhere.
!/scripts/
!/scripts/materialize-role-scripts.sh
!/scripts/credential-resolver-classification.yml
!/scripts/generate-credential-resolver-vars.py
!/scripts/Set-DnsNamespaceForwarder.ps1
!/scripts/Set-DnsNamespaceForwarder.pester.ps1
!/scripts/Set-FileAcl.ps1
!/scripts/Set-FileAcl.pester.ps1

# GitHub
!/.github/
!/.github/**

