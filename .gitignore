# Ignore everything by default
**

# Every allowlist negation is repository-rooted. make allowlist-check rejects rootless entries.

# Root config and docs
!/.ansible-lint
!/.editorconfig
!/.gitattributes
!/.gitignore
!/.pre-commit-config.yaml
!/.release-please-manifest.json
!/.yamllint.yml
!/ansible.cfg
!/CHANGELOG.md
!/CODE_OF_CONDUCT.md
!/CONTRIBUTING.md
!/LICENSE
!/Makefile
!/README.md
!/SECURITY.md
!/SUPPORT.md
!/release-please-config.json
!/requirements-dev.txt

# GitHub
!/.github/
!/.github/**

# Role directories
!/applications/
!/applications/linux_disk_manager/
!/applications/windows_disk_manager/
