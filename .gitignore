# Ignore everything by default
**

# Every allowlist negation is repository-rooted. make allowlist-check rejects rootless entries.

# Root config and docs
!/.ansible-lint
!/.editorconfig
!/.gitattributes
!/.gitignore
!/.pre-commit-config.yaml
!/.release-please-manifest.json
!/.yamllint.yml
!/ansible.cfg
!/CHANGELOG.md
!/CODE_OF_CONDUCT.md
!/CONTRIBUTING.md
!/LICENSE
!/Makefile
!/README.md
!/SECURITY.md
!/SUPPORT.md
!/release-please-config.json
!/requirements-dev.txt
!/requirements.yml

# First-class PowerShell scripts and their Pester specs. A role that executes one tracks only
# files/<Name>.ps1.stub; scripts/materialize-role-scripts.sh copies the source below into the role
# before it runs. The source and its spec are reviewed once, here -- the materialized copy in a
# role's files/ directory is a build artifact and is never allowlisted anywhere.
!/scripts/
!/scripts/materialize-role-scripts.sh
!/scripts/Set-DnsNamespaceForwarder.ps1
!/scripts/Set-DnsNamespaceForwarder.pester.ps1
!/scripts/Set-FileAcl.ps1
!/scripts/Set-FileAcl.pester.ps1

# GitHub
!/.github/
!/.github/**

