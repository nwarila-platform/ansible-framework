---
# =============================================================================
# ansible-lint Configuration
# =============================================================================
# Profile: safety — enforces critical security and correctness rules without
# blocking on stylistic preferences. Upgrade to 'production' once all roles
# are stable and molecule tests are in place.
#
# Docs: https://ansible.readthedocs.io/projects/lint/configuring/
# =============================================================================

profile: safety

# -----------------------------------------------------------------------------
# Exclude Paths
# -----------------------------------------------------------------------------
# The Makefile supplies every cached or visible role YAML path explicitly because bare discovery
# sees no role files through this repository's deny-all .gitignore. RedHat_Rocky_9 alone remains
# excluded because it is an empty stub.
# -----------------------------------------------------------------------------
exclude_paths:
  - .git/
  - .github/
  - operating_systems/RedHat_Rocky_9/

# -----------------------------------------------------------------------------
# Warnings (non-blocking)
# -----------------------------------------------------------------------------
# Rules that should surface as warnings rather than errors during the
# current development phase. Remove entries as gaps are closed.
# -----------------------------------------------------------------------------
warn_list:
  - experimental              # Rules still being stabilized in ansible-lint
  - yaml[line-length]         # Already warned by yamllint; avoid double noise
  # The framework uses paired #region/#endregion markers as navigational delimiters. Their
  # no-space spelling is intentional and shared by every loader and bootstrap task list.
  - yaml[comments]
  # Public OS role names retain their established CamelCase product identifiers.
  - role-name

# -----------------------------------------------------------------------------
# Offline Mode
# -----------------------------------------------------------------------------
# Disable Galaxy resolution in CI to avoid network calls during lint.
# Set to false if roles have Galaxy dependencies that need resolving.
# -----------------------------------------------------------------------------
offline: true

# -----------------------------------------------------------------------------
# Loop Variable Prefix
# -----------------------------------------------------------------------------
# Deliberately not set. ansible-lint's loop-var-prefix rule fires only for
# files it attributes to a role under roles/; this repository's namespaces
# (applications/, host_roles/, operating_systems/, utilities/) are never
# attributed, so the option enforced nothing here (measured 2026-09-11: 25
# loop variables outside the pattern, zero findings).
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Mock Roles
# -----------------------------------------------------------------------------
# Roles referenced in tasks but not present in this repo (e.g., prerequisites
# pulled from Galaxy at runtime). List them here to suppress resolution errors.
# -----------------------------------------------------------------------------
mock_roles: []

# -----------------------------------------------------------------------------
# Mock Modules
# -----------------------------------------------------------------------------
mock_modules: []
